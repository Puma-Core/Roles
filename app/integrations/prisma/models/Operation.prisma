enum OperationType {
  CREATE
  READ
  UPDATE
  DELETE
}

model Operation {
  id           String        @id @default(uuid())
  label        String
  name         String        @unique
  tool         String
  operation    Json
  permission   Permission?   @relation("PermissionOperations", fields: [permissionId], references: [id])
  permissionId String?
  permisosId   String?
}
