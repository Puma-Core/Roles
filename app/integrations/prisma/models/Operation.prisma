enum OperationType {
  CREATE
  READ
  UPDATE
  DELETE
}

model Operation {
  id           Int           @id @default(autoincrement())
  label        String
  name         String        @unique
  tool         String
  operation    Json
  permission   Permission?   @relation("PermissionOperations", fields: [permissionId], references: [id])
  permissionId Int?
}
