{
  "name": "obel_roles",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "dev": "npm run db:setup && tsx watch --clear-screen=false main.ts",
    "start": "npm run db:setup && tsx main.ts",
    "db:generate": "npx prisma generate --config app/integrations/prisma/prisma.config.ts",
    "db:migrate": "npx prisma migrate deploy --config app/integrations/prisma/prisma.config.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "npm run db:generate && npm run db:migrate && npm run db:seed",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathPattern='tests/unitTests'",
    "test:integration": "jest --runInBand --testPathPattern='tests/integration'"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.1.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5"
  },
  "devDependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.14",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.1",
    "better-sqlite3": "^12.10.0",
    "jest": "^29.7.0",
    "jest-mock-extended": "^4.0.1",
    "prisma": "^7.8.0",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
