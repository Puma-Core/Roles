# PRISMA SETTINGS
PRISMA_CONFIG_PATH=./
PRISMA_MIGRATIONS_PATH=./migrations
PRISMA_DATASOURCE_URL=file:./dev.db
PRISMA_GENERATOR_PROVIDER=prisma-client-js
PRISMA_DB_PROVIDER=sqlite
PRISMA_CONFIG_JS=./

# SECURITY
API_SECRET_KEY_API=your_secret_key_here

## FASTIFY
FASTIFY_PORT=3012

## BCRYPT
BCRYPT_SALT_ROUNDS=10